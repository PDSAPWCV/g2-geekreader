{
  "name": "g2-geekreader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "tsx --test test/feed.test.ts test/reader.test.ts test/layout.test.ts",
    "verify:sim": "tsx scripts/sim-verify.ts",
    "verify:sim:full": "tsx scripts/sim-verify.ts --prod http://localhost:4173 --worker http://127.0.0.1:8790",
    "verify:sim:deployed": "tsx scripts/sim-verify.ts --prod http://localhost:4173",
    "simulator": "evenhub-simulator http://localhost:5175",
    "simulator:auto": "evenhub-simulator http://localhost:5175/?debug=1 --automation-port 9898",
    "qr": "evenhub qr",
    "pack": "npm run build && tsx scripts/pack.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vite": "^8.3.8"
  },
  "license": "MIT"
}
